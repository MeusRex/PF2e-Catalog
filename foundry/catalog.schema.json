{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/fantasy-image-catalog/catalog.schema.json",
  "title": "Fantasy Image Catalog Export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "moduleId", "taxonomyVersion", "imageCount", "images"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "moduleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "taxonomyVersion": { "type": "string" },
    "imageCount": { "type": "integer", "minimum": 0 },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "portrait", "thumbnail", "filename", "caption", "tags", "reviewStatus", "width", "height"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "portrait": { "type": "string" },
          "thumbnail": { "type": "string" },
          "filename": { "type": "string" },
          "caption": { "type": "string" },
          "tags": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          },
          "reviewStatus": { "enum": ["unclassified", "classified", "needs_review", "reviewed"] },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
