<aside class="fic-search" data-application-part="search">
  <label>
    <span>Search</span>
    <input type="search" placeholder="stern dwarven priest" autocomplete="off">
  </label>
  <div class="fic-results"><strong data-results-count>{{imageCount}}</strong> images</div>
  <p class="fic-filter-help">Click a tag to include it; click again to exclude it. Right-click reverses the cycle.</p>
</aside>
